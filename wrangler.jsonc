{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "blog-ojii3-dev",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2025-07-12",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// SSR pages include authenticated admin data and must not be served from
	// Workers Caching. Add route-specific caching only after setting explicit
	// Cache-Control headers for every dynamic response.
	"cache": {
		"enabled": false
	},
	"observability": {
		"enabled": true
	},
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"vars": {
		"MEDIA_BASE_URL": "https://media.blog.ojii3.dev",
		"ACCESS_AUTH_REQUIRED": "true"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "blog-content",
			"database_id": "eff6e29e-7810-4092-8d1b-f2a48289a751",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "blog-media"
		}
	],
	"env": {
		"preview": {
			"name": "blog-ojii3-dev-preview",
			"workers_dev": true,
			"preview_urls": true,
			"vars": {
				"MEDIA_BASE_URL": "https://media-preview.blog.ojii3.dev",
				"ACCESS_AUTH_REQUIRED": "false"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "blog-content-preview",
					"database_id": "7b921086-1e3e-42d0-92a6-3ca91a5316d6",
					"migrations_dir": "drizzle"
				}
			],
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "blog-media-preview"
				}
			]
		}
	}
}
