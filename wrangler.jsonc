{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "blog-ojii3-dev",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2025-07-12",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"observability": {
		"enabled": true
	},
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	}
}
