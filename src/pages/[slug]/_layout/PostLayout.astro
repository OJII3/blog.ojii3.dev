---
import PostShell from "@/pages/_components/PostShell.astro";
import type { VitaColor } from "@/pages/_lib/constants";

export interface LiveBlogEntry {
	id: string;
	data: {
		title: string;
		dateString: string;
		color: VitaColor;
		tags: string[];
		draft: boolean;
		html: string;
		revision: number;
	};
}

export type LiveBlogEntryLink = {
	id: string;
	data: { title: string };
};

export interface Props {
	prevPost: LiveBlogEntryLink | null;
	nextPost: LiveBlogEntryLink | null;
	post: LiveBlogEntry;
	ogImageUrl: string;
}

const { post, prevPost, nextPost, ogImageUrl } = Astro.props;
const { title, dateString, color, tags, html } = post.data;
---

<PostShell
	title={title}
	dateString={dateString}
	color={color}
	tags={tags}
	postId={post.id}
	ogImageUrl={ogImageUrl}
	prevPost={prevPost}
	nextPost={nextPost}
	html={html}
/>
