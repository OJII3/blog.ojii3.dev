---
export const prerender = false;

import { getLiveEntry } from "astro:content";
import { createContentDb, getContentEnv } from "@/db/client";
import { getAdjacentPosts } from "@/lib/content/repository";
import { getOgImageUrl } from "@/lib/og-image-path";
import PostLayout from "./_layout/PostLayout.astro";

const { slug } = Astro.params;
if (!slug) {
	return new Response("Not found", { status: 404 });
}

const { entry: post, error: entryError } = await getLiveEntry("blog", {
	id: slug,
});
if (entryError) {
	if (entryError.name !== "LiveEntryNotFoundError") throw entryError;
	return new Response("Not found", { status: 404 });
}
if (!post || post.data.draft) {
	return new Response("Not found", { status: 404 });
}

const env = await getContentEnv();
const { prevPost: adjacentPrevPost, nextPost: adjacentNextPost } =
	await getAdjacentPosts(createContentDb(env), {
		slug: post.id,
		date: post.data.date,
	});
const ogImageUrl = getOgImageUrl(
	env.MEDIA_BASE_URL,
	post.id,
	post.data.revision,
);
const prevPost = adjacentPrevPost
	? { id: adjacentPrevPost.slug, data: { title: adjacentPrevPost.title } }
	: null;
const nextPost = adjacentNextPost
	? { id: adjacentNextPost.slug, data: { title: adjacentNextPost.title } }
	: null;
---

<PostLayout
	post={post}
	prevPost={prevPost}
	nextPost={nextPost}
	ogImageUrl={ogImageUrl}
/>
