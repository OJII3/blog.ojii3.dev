---
import { getLiveEntry } from "astro:content";
import { getContentEnv } from "@/db/client";
import { getOgImageUrl } from "@/lib/og-image-path";
import PostShell from "@/pages/_components/PostShell.astro";
import AdminLayout from "../_layouts/AdminLayout.astro";

export const prerender = false;

const { slug } = Astro.params;

if (!slug) return Astro.redirect("/admin");

const { entry, error } = await getLiveEntry("blog", {
	id: slug,
});

if (error) {
	return Astro.redirect("/404");
}

const env = await getContentEnv();
const ogImageUrl =
	entry && !entry.data.draft
		? getOgImageUrl(env.MEDIA_BASE_URL, entry.id, entry.data.revision)
		: undefined;
---

<AdminLayout>
	{entry ? (
			<PostShell
				title={entry.data.title}
				dateString={entry.data.dateString}
				color={entry.data.color}
				tags={entry.data.tags}
				postId={slug}
				ogImageUrl={ogImageUrl}
				html={entry.data.html}
			/>
		) : (
			<div />
		)}
</AdminLayout>
